# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=65536
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_THINKING=true
# Per-request HTTP timeout for chat/completions (seconds)
DEEPSEEK_TIMEOUT=300
# Overall LangGraph agent run budget (seconds; multi-round tools + LLM)
AGENT_RUN_TIMEOUT=900
# Per tool-call wall-clock timeout inside the tools node (seconds)
TOOL_CALL_TIMEOUT=120
# Halt agent when the same tool+params is requested this many times
TOOL_IDENTICAL_CALL_LIMIT=3
# Max tool-enabled LLM rounds per invoke (~2× typical 6-step task)
AGENT_MAX_ROUNDS=12
# Ask Agent: keep last N user/assistant pairs as LLM history
ASK_AGENT_HISTORY_TURNS=6
# Brave web search (optional). The agent calls it only when WallStreetCN
# news search returns nothing relevant. https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=

# Default news poll crontab (5 fields, APP_TIMEZONE). Editable on Jobs page.
# 0 8-22/2 * * * → every 2 hours from 08:00–22:00
NEWS_CRONTAB=0 8-22/2 * * *

# Display timezone for UI / logs (DB stays UTC). Default Beijing.
APP_TIMEZONE=Asia/Shanghai

# Public access password gate (set AUTH_ENABLED=true before exposing to the internet)
AUTH_ENABLED=false
AUTH_PASSWORD=
AUTH_MAX_FAILURES=3

# Telegram (optional — leave empty to disable notifications)
# Send-only: recommendations are pushed as text. Accept/Dismiss on Dashboard.
# Do NOT long-poll getUpdates (bot token may be shared with OpenClaw).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_POLL_MAX_BACKOFF=60

# A2A server (optional). Other agents can call this portfolio agent.
# Leave A2A_ENABLED=false unless A2A_TOKEN is set. Card URL should be the
# public address when the process sits behind a reverse proxy.
# setup-server.sh enables A2A and generates a token automatically.
A2A_ENABLED=false
A2A_PORT=8502
A2A_TOKEN=
A2A_PUBLIC_URL=
# Bind to loopback behind an HTTPS reverse proxy.
A2A_HOST=127.0.0.1
# GPT Actions REST API uses the same port, with its own bearer token.
ACTIONS_ENABLED=false
ACTIONS_TOKEN=
ACTIONS_PUBLIC_URL=

# LangSmith observability (optional — traces prompts, tools, tokens)
# https://smith.langchain.com — set API key to enable tracing by default
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-agent
# LANGSMITH_TRACING=false  # set to disable even when API key is present

# Investment memory. Full-text search and history capture work without APIs.
MEMORY_ENABLED=true
# Opt-in: enables sending indexed text to your selected embedding provider.
MEMORY_VECTOR_ENABLED=false
# Embeddings-compatible endpoint; requests go to <base>/embeddings.
# Configure this independently from the DeepSeek chat API.
# Copy the base URL from your Bailian workspace. Example for Beijing:
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# The key must belong to the same workspace/region. Do not use the chat endpoint.
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
# DASHSCOPE_API_KEY is also accepted when the memory-specific key is empty.
MEMORY_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# Must match the model's actual output dimension. Changing model/URL/dimension
# automatically builds a new collection; old collections remain for rollback.
MEMORY_EMBEDDING_DIMENSIONS=1024
# Set false only for a different provider that rejects the dimensions parameter.
MEMORY_EMBEDDING_SEND_DIMENSIONS=true
MEMORY_QDRANT_URL=http://127.0.0.1:6333
MEMORY_QDRANT_API_KEY=
MEMORY_COLLECTION=portfolio_memory
# Single worker; remote embeddings, no local model.
# Text chunks per embedding HTTP request (Bailian flash: max 20).
MEMORY_BATCH_SIZE=20
# Documents per worker pass; separate from embedding request size.
MEMORY_IMPORT_BATCH_SIZE=50
MEMORY_LEXICAL_BATCH_SIZE=50
MEMORY_VECTOR_DOCUMENT_BATCH_SIZE=4
MEMORY_INTERVAL_SECONDS=10
